{
  "name": "offboarding-huly-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Huly IM/Doc sidecar — Python backend 到 Huly TS SDK 的转接层（端口 7777）",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ --ext .ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "@hcengineering/api-client": "0.7.423",
    "@hcengineering/server-token": "0.7.423",
    "@hcengineering/server-client": "0.7.423",
    "@hcengineering/chunter": "0.7.423",
    "@hcengineering/contact": "0.7.423",
    "@hcengineering/document": "0.7.423",
    "@hcengineering/core": "0.7.423",
    "@hcengineering/platform": "0.7.423"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
