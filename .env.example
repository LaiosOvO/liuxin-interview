# AI 离职流程系统 — 配置模板（可提交到 git）
# 真实凭证写到 .env（gitignored）

# =========================================
# 应用基础
# =========================================
APP_MODE=demo
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# Phase 6（SUMMARY R1）: 深链基址走 nginx :80（不带 :3000）
# nginx 反代 /api/ → flow-api:8000；nginx + flow-api 共占 80 端口对外
DEEPLINK_BASE_URL=http://192.168.2.44

# =========================================
# Phase 1: 数据库 / Redis
# =========================================
POSTGRES_PASSWORD=changeme_in_real_env
POSTGRES_DSN=postgresql+asyncpg://flow:changeme_in_real_env@offboarding-postgres:5432/offboarding
LANGGRAPH_PG_CONNINFO=postgres://flow:changeme_in_real_env@offboarding-postgres:5432/offboarding
REDIS_URL=redis://offboarding-redis:6379/0

# =========================================
# Phase 3: 鉴权 / JWT / Session
# =========================================
# JWT_SECRET 生成：openssl rand -hex 32
# 生产模式（APP_MODE=prod）启动会校验 — 必须改非默认值
JWT_SECRET=changeme_in_real_env_openssl_rand_hex_32
TOKEN_EXPIRY_HOURS=24
SESSION_EXPIRY_HOURS=24
# 内网 HTTP 部署保持 false；HTTPS 部署改 true（cookie 才会带 Secure）
HTTPS_ENABLED=false
SESSION_COOKIE_NAME=offboarding_session

# =========================================
# Phase 4: 通知 — Mattermost / SMTP / MinIO / GLM（Phase 1 暂不使用）
# =========================================
MATTERMOST_URL=http://192.168.2.44:8065
MATTERMOST_TEAM=laios
MATTERMOST_BOT_USERNAME=offboarding-bot
MATTERMOST_BOT_USER_ID=__from_bot_create__
MATTERMOST_BOT_TOKEN=changeme_in_real_env
# Outgoing Webhook token —— Mattermost 后台创建 Outgoing Webhook 时生成；用于校验入站 webhook 请求
MATTERMOST_OUTGOING_WEBHOOK_TOKEN=changeme_in_real_env
# HTTP 调用超时（秒）— 内网调用给短超时，避免节点函数阻塞
MATTERMOST_HTTP_TIMEOUT=10.0

MM_ADMIN_USERNAME=admin
MM_ADMIN_PASSWORD=changeme_in_real_env

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=changeme_in_real_env@qq.com
SMTP_PASSWORD=changeme_in_real_env_16char_authcode
SMTP_FROM_NAME=离职流程 Bot

DEMO_INBOX=changeme_in_real_env@qq.com

MINIO_ENDPOINT=http://192.168.2.44:9000
MINIO_CONSOLE=http://192.168.2.44:9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme_in_real_env
MINIO_ACCESS_KEY=changeme_in_real_env
MINIO_SECRET_KEY=changeme_in_real_env
MINIO_BUCKET_ATTACHMENTS=offboarding-attachments
MINIO_BUCKET_EXPORTS=offboarding-exports
MINIO_BUCKET_SCREENSHOTS=offboarding-screenshots
MINIO_USE_SSL=false

LLM_PROVIDER=glm
GLM_API_KEY=changeme_in_real_env
# GLM via openai 兼容接口（STACK.md §4.6）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4.6
# 单次调用超时秒数 — 超时 / 失败均降级（PITFALLS #22 + PRD LLM-03）
GLM_TIMEOUT_SECONDS=8

# =========================================
# Phase 4.5 — AutoNode 外部归档服务（PRD §18 加分项）
# =========================================
# mock-archive-service 容器内地址（docker-compose 默认）；host 调试时用 http://localhost:5050/archive
ARCHIVE_SERVICE_URL=http://mock-archive-service:5000/archive
ARCHIVE_SERVICE_TIMEOUT_SECONDS=8.0
ARCHIVE_SERVICE_MAX_RETRIES=3

# =========================================
# Phase 6 — 节点超时扫描（NOTI-05 + TIMEOUT-01，PRD §17.1）
# =========================================
# 节点 SLA = NODE_TIMEOUT_HOURS 小时（默认 24）
NODE_TIMEOUT_HOURS=24
# 演示快速触发：仅 APP_MODE=demo 时生效；非空时优先级高于 NODE_TIMEOUT_HOURS
# 示例：0.05 ≈ 3 分钟，方便演示逾期；prod 必须留空
DEMO_TIMEOUT_OVERRIDE_HOURS=
# 扫描频率（秒）— 默认 60s 一次
TIMEOUT_SCAN_INTERVAL_SECONDS=60

# =========================================
# Phase 6 — 演示模式邮箱映射（PRD §9.1.3 用户明确）
# =========================================
# JSON 形式：{"zhang.san": "1624456575@qq.com", ...}
# 留空走代码内置 DEMO_INBOX_MAP_DEFAULT（已含 8 个测试账号 → 3 个真邮箱）
DEMO_INBOX_MAP=

# =========================================
# Phase 8 — Huly Platform（opt-in：仅在 --profile huly-stack / huly 时使用）
# =========================================
# 默认 docker compose up -d 不读这些；只有启用 huly-stack profile 才需要填。
# 所有 HULY_SERVER_SECRET 必须在 huly-account / huly-transactor / huly-collaborator /
# huly-workspace / huly-front / huly-stats / huly-fulltext / huly-kvs / huly-rekoni /
# huly-love / huly-print 与 huly-bridge sidecar 中完全一致；任何一处不一致都会
# 导致 token 验签失败（详见 deploy/huly/HULY_IMAGES.md#已知-pitfall）。
#
# 默认对接 192.168.2.44；改部署机时同步改 IP 与端口。

# Huly 业务版本（11 个 hardcoreeng/* 镜像共用）
HULY_VERSION=v0.7.423

# Huly Front 入口（用户浏览器访问；与 docker-compose huly-front ports 8087:8080 对应）
HULY_URL=http://192.168.2.44:8087

# Huly Account API（sidecar 通过此 URL 调 /api/v1/login 拿 workspace token）
HULY_ACCOUNTS_URL=http://192.168.2.44:3007

# Huly Workspace 名（首次安装时在 UI 创建；Plan 04 sidecar 启动前必须存在）
HULY_WORKSPACE=laios

# Huly HMAC 密钥（必填；openssl rand -hex 32 生成 64 字符）
HULY_SERVER_SECRET=changeme_in_real_env_openssl_rand_hex_32

# huly-bridge sidecar 与本项目 backend 通信的 bearer token（openssl rand -hex 16）
HULY_BRIDGE_TOKEN=changeme_in_real_env_openssl_rand_hex_16

# Huly MinIO 凭证（仅 huly-stack profile 起的独立 MinIO，端口 9091/9092；与项目原 MinIO 9000/9001 隔离）
HULY_MINIO_USER=minioadmin
HULY_MINIO_PASSWORD=changeme_in_real_env

# huly-bridge sidecar URL（docker network 内 service name + 端口；Python backend 用）
HULY_BRIDGE_URL=http://huly-bridge:7777

# bot AccountUuid — Plan 04 起用 systemAccountUuid（保持空让 sidecar fallback）；
# Plan 06 seed 完真实 bot 账号后填入对应 UUID 提高死循环防护准确性
HULY_BOT_ACCOUNT_UUID=

# === Huly admin（Plan 06 / HULY-08 — 仅 seed 时用；seed 完可清空） ===
# 这些凭证仅供 scripts/seed_huly_users.py 把 13 个业务用户同步到 Huly 用
# 真实场景：开机 → seed → 清空 admin 凭证 → 重启 sidecar（让 admin 路由不挂载，纯业务安全）
# Huly admin 邮箱（在 Huly UI 首次安装时创建的 super admin 账号）
HULY_ADMIN_EMAIL=admin@huly.local
# Huly admin 密码
HULY_ADMIN_PASSWORD=changeme_admin_password
# sidecar admin API 鉴权 token（openssl rand -hex 32；与 BRIDGE_TOKEN 不同 secret）
# 这是 admin API 的「第二道」保护，确保 LLM 通过 BRIDGE_TOKEN 调不到 admin 路由
HULY_ADMIN_TOKEN=changeme_admin_token_openssl_rand_hex_32
# Seed 用户的默认密码（演示用；生产应每个用户单独密码）
HULY_USER_PASSWORD=changeme_seeded_user_default_password
